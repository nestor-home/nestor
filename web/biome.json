{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!src/api/schema.gen.ts",
      "!openapi.json",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "cmdk": "Import Command* from @/components/ui/command.",
              "react-day-picker": "Import Calendar (and its types and locales) from @/components/ui/calendar.",
              "@base-ui/react": "Import the shadcn component from @/components/ui, not the Base UI primitive."
            },
            "patterns": [
              {
                "group": ["@base-ui/react/*"],
                "message": "Import the shadcn component from @/components/ui, not the Base UI primitive."
              },
              {
                "group": ["react-day-picker/*"],
                "message": "Import Calendar (and its locales) from @/components/ui/calendar."
              }
            ]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/styles/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "noLabelWithoutControl": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**", "src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "plugins": [
    "./lint/no-native-form-controls.grit",
    "./lint/no-hand-rolled-widgets.grit",
    "./lint/cmdk-attribute-values.grit",
    "./lint/no-boolean-data-attribute.grit"
  ]
}
