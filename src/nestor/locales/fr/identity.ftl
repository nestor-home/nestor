# Ce qu'une personne lit pour enregistrer sa voix : comme on parle à l'assistant, avec des sons variés.
voice-phrase-1 = Nestor, allume la lumière du salon.
voice-phrase-2 = Quel temps fera-t-il demain matin ?
voice-phrase-3 = Rappelle-moi d'appeler le plombier jeudi.
voice-phrase-4 = Ajoute du pain, des pommes et du café à la liste de courses.
voice-phrase-5 = Raconte-moi l'histoire d'un gardien de phare.

# Enregistrer sa voix à voix haute, sur un satellite.
voice-enroll-start = Je t'écoute. Répète après moi : { $phrase }
voice-enroll-next = Bien. Maintenant : { $phrase }
voice-again-too-short = C'était un peu court. Encore une fois : { $phrase }
voice-again-too-quiet = Je t'entends à peine. Un peu plus fort : { $phrase }
voice-again-too-loud = C'était trop fort. Un peu moins : { $phrase }
voice-again-other-voice = Ce n'était pas la même voix. Encore une fois : { $phrase }
voice-enroll-done = C'est fait : je reconnaîtrai ta voix.
