# Modifier la configuration depuis l'administration : problèmes, sections, emplacements, titres des champs.

config-error-missing = { $path } : obligatoire.
config-error-extra = { $path } : réglage inconnu.
config-error-invalid = { $path } : { $detail }
config-error-unknown-kind = { $path } : aucun plugin « { $detail } » n'est installé.
config-error-reference = { $path } : la variable d'environnement { $detail } n'est pas définie.
config-error-secret = { $path } : le secret { $detail } n'est pas défini.
config-error-no-answering-model = { $path } : plusieurs modèles peuvent répondre ({ $detail }). Choisissez le modèle à l'oral, à l'écrit, ou les deux.
config-error-not-answering = { $path } : { $detail } ne sait pas répondre. Choisissez un LLM.
config-error-not-embedding = { $path } : { $detail } n'est pas un modèle d'embedding.
config-error-not-speaker = { $path } : { $detail } ne sait pas distinguer les voix. Choisissez un modèle de reconnaissance du locuteur.
config-error-not-transcribing = { $path } : { $detail } ne sait pas transcrire la parole. Choisissez un modèle de transcription.
config-error-not-speaking = { $path } : { $detail } ne sait pas parler. Choisissez un modèle de synthèse vocale.
config-error-unknown-model = { $path } : aucun modèle { $detail } dans Modèles.
config-error-shared-account = { $path } : ce compte appartient déjà à une autre personne.

