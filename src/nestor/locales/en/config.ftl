# Editing the configuration from the admin: problems, sections, slots and the fields' titles.
# A field's title is `config-<group>-<field>`, else the generic `config-field-<field>`; its help is
# `config-<group>-<field>-help`. Plugins ship the titles of their own settings (`config-<family>-<kind>-…`).

config-error-missing = { $path }: required.
config-error-extra = { $path }: unknown setting.
config-error-invalid = { $path }: { $detail }
config-error-unknown-kind = { $path }: no plugin “{ $detail }” is installed.
config-error-reference = { $path }: the environment variable { $detail } is not set.
config-error-secret = { $path }: the secret { $detail } is not set.
config-error-no-answering-model = { $path }: several models can answer ({ $detail }). Choose the spoken model, the written model, or both.
config-error-not-answering = { $path }: { $detail } cannot answer. Choose an LLM.
config-error-not-embedding = { $path }: { $detail } is not an embedding model.
config-error-not-speaker = { $path }: { $detail } cannot tell voices apart. Choose a speaker recognition model.
config-error-not-transcribing = { $path }: { $detail } cannot transcribe speech. Choose a transcription model.
config-error-not-speaking = { $path }: { $detail } cannot speak. Choose a speech model.
config-error-unknown-model = { $path }: no model named { $detail } in Models.
config-error-shared-account = { $path }: this account already belongs to someone else.

