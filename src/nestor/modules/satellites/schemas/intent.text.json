{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestorhome.dev/schemas/satellite/1/intent.text.json",
  "title": "The assistant's words, to show (needs `text.display`); `final` on the last message of a turn.",
  "x-protocol": "nestor.satellite/1",
  "x-direction": "to_satellite",
  "type": "object",
  "properties": {
    "type": {
      "const": "intent.text"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "id",
    "at",
    "payload"
  ],
  "additionalProperties": false
}
