{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestor.mathislambert.fr/schemas/satellite/1/welcome.json",
  "title": "Answer to `hello`: where the device is and what it was allowed to do.",
  "x-protocol": "nestor.satellite/1",
  "x-direction": "to_satellite",
  "type": "object",
  "properties": {
    "type": {
      "const": "welcome"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "room": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "device_id",
        "room",
        "capabilities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "id",
    "at",
    "payload"
  ],
  "additionalProperties": false
}
