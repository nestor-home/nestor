{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestor.mathislambert.fr/schemas/satellite/2/pairing.request.json",
  "title": "POST /satellites/pairings: a device asks to pair",
  "x-protocol": "nestor.satellite/2",
  "type": "object",
  "properties": {
    "manifest": {
      "$ref": "manifest.json"
    },
    "enrollment_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "method": {
      "enum": [
        "enrollment.input",
        "enrollment.provisioning",
        "enrollment.qr"
      ]
    }
  },
  "required": [
    "manifest"
  ],
  "dependentRequired": {
    "enrollment_code": [
      "method"
    ],
    "method": [
      "enrollment_code"
    ]
  },
  "additionalProperties": false
}
